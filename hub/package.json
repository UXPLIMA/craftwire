{
  "name": "craftwire",
  "version": "0.7.1",
  "mcpName": "io.github.UXPLIMA/craftwire",
  "description": "MCP hub that lets AI agents see and drive Minecraft (Craftwire by UXPLIMA)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/uxplima/craftwire.git", "directory": "hub" },
  "homepage": "https://github.com/uxplima/craftwire#readme",
  "bugs": { "url": "https://github.com/uxplima/craftwire/issues" },
  "keywords": ["minecraft", "mcp", "model-context-protocol", "claude", "fabric", "paper", "ai-agent"],
  "type": "module",
  "bin": {
    "craftwire": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agent",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node scripts/copy-skills.mjs && node scripts/copy-agent.mjs && node scripts/copy-docs.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
